<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Quản trị HoangHaPC</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/PagedList.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <!-- ===== HEADER: thanh menu quản trị ===== -->
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("HoangHaPC Admin", "Index", "Home", new { area = "Admin" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav">
                    <li class="nav-item">@Html.ActionLink("Home", "Index", "Home", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Danh mục", "Index", "Categories", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Sản phẩm", "Index", "Products", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Khách hàng", "Index", "Customers", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Đơn hàng", "Index", "Orders", new { area = "Admin" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Tài khoản", "Index", "Users", new { area = "Admin" }, new { @class = "nav-link" })</li>
                </ul>
                @if (Session["Username"] != null) //Bên phải thanh menu hiển thị tên người đăng nhập và đăng xuất
                {
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <span class="navbar-text me-3">Chào mừng quay trở lại, <strong>@Session["Username"]</strong></span>
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Đăng xuất", "Logout", "Account", new { area = "Admin" }, new { @class = "nav-link" })
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <div class="container body-content mt-3">
        <h1>TRANG QUẢN TRỊ</h1>

        <!-- Nội dung của từng trang Admin sẽ được chèn vào đây -->
        @RenderBody()
        
        <!-- ===== FOOTER ===== -->
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - PC Builder</p>
            <h3>Thành viên nhóm</h3>
            <p>Trần Hồng Quân</p>
            <p>Lê Quang Bình</p>
            <p>Nguyễn Hữu Mạnh Phú</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>