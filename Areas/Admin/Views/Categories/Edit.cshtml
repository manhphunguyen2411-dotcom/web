@model HoangHaPCVN.Models.Category

@{
    ViewBag.Title = "Cập nhật danh mục";
}

<h2 class="bg-success text-white p-2">CẬP NHẬT DANH MỤC</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @* Ô ẩn giữ mã danh mục để biết đang sửa bản ghi nào *@
    @Html.HiddenFor(model => model.CategoryID)

    @* Partial View *@
    @Html.Partial("PVCreateEditCategory", Model)
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
