@model HoangHaPCVN.Models.Customer

@{
    ViewBag.Title = "Chi tiết khách hàng";
}

<h2 class="bg-success text-white p-2">CHI TIẾT KHÁCH HÀNG</h2>

<dl class="row bg-light border rounded p-3">
    <dt class="col-sm-3">Họ và tên</dt>
    <dd class="col-sm-9">@Model.CustomerName</dd>

    <dt class="col-sm-3">Số điện thoại</dt>
    <dd class="col-sm-9">@Model.CustomerPhone</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.CustomerEmail</dd>

    <dt class="col-sm-3">Địa chỉ</dt>
    <dd class="col-sm-9">@Model.CustomerAddress</dd>

    <dt class="col-sm-3">Tên đăng nhập</dt>
    <dd class="col-sm-9">@Model.Username</dd>
</dl>

<h4>Đơn hàng của khách (@Model.Orders.Count đơn)</h4>

@if (Model.Orders.Any())
{
    <table class="table table-bordered align-middle">
        <thead class="table-success">
            <tr>
                <th>Mã đơn</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model.Orders.OrderByDescending(o => o.OrderDate))
            {
                <tr>
                    <td>#@o.OrderID</td>
                    <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@o.TotalAmount.ToString("N0") đ</td>
                    <td>@(o.OrderStatus ?? "Chưa cập nhật")</td>
                    <td>@Html.ActionLink("Chi tiết đơn", "Details", "Orders", new { id = o.OrderID }, new { @class = "btn btn-info btn-sm" })</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="alert alert-secondary">Khách hàng này chưa có đơn hàng nào.</p>
}

@Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })