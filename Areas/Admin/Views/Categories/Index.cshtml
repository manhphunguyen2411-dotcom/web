@model IEnumerable<HoangHaPCVN.Models.Category>

@{
    ViewBag.Title = "Danh mục";
}

<h2 class="bg-success text-white p-2">DANH SÁCH DANH MỤC</h2>

<table class="table table-bordered align-middle">
    <thead class="table-success">
        <tr>
            <th>TÊN DANH MỤC</th>
            <th style="width: 200px"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.CategoryName)</td>
                <td>
                    @Html.ActionLink("Cập nhật", "Edit", new { id = item.CategoryID },
                        new { @class = "btn btn-primary btn-sm" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID },
                        new { @class = "btn btn-danger btn-sm" })
                </td>
            </tr>
        }
    </tbody>
</table>

<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
</p>
