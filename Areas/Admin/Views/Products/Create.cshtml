@model HoangHaPCVN.Models.Product

@{
    ViewBag.Title = "Thêm sản phẩm";
}

<h2 class="bg-success text-white p-2">THÊM SẢN PHẨM</h2>

@using (Html.BeginForm("Create", "Products", FormMethod.Post,
    new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @Html.Partial("PVCreateEditProduct", Model)

    <div class="mb-3">
        <input type="submit" value="Thêm mới" class="btn btn-primary" />
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
