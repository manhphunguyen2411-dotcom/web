@model HoangHaPCVN.Models.Product

@{
    ViewBag.Title = "Cập nhật sản phẩm";
}

<h2 class="bg-success text-white p-2">CẬP NHẬT SẢN PHẨM</h2>

@using (Html.BeginForm("Edit", "Products", FormMethod.Post,
    new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @* Ô ẩn giữ mã sản phẩm để biết đang sửa sản phẩm nào *@
    @Html.HiddenFor(model => model.ProductID)

    @* Ô ẩn giữ đường dẫn ảnh cũ: không chọn ảnh mới thì vẫn giữ ảnh cũ *@
    @Html.HiddenFor(model => model.ProductImage)

    @Html.Partial("PVCreateEditProduct", Model)

    <div class="mb-3">
        <input type="submit" value="Lưu" class="btn btn-primary" />
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-secondary" })
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
