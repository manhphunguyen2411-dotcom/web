@using PagedList.Mvc
@model HoangHaPCVN.Models.ViewModel.ProductSearchVM

@* Hiển thị danh sách sản phẩm *@
@if (Model.Products != null && Model.Products.Any())
{
    <table class="table table-bordered align-middle">
        <thead class="table-success">
            <tr>
                <th style="width: 120px">Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th style="width: 140px">Đơn giá</th>
                <th style="width: 180px">Danh mục</th>
                <th style="width: 220px"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                string anh = string.IsNullOrEmpty(product.ProductImage)
                    ? "~/Content/images/default_img.png"
                    : product.ProductImage;

                <tr>
                    <td>
                        <img src="@Url.Content(anh)" alt="@product.ProductName"
                             style="height: 80px; max-width: 100px; object-fit: contain" />
                    </td>
                    <td>@Html.DisplayFor(modelItem => product.ProductName)</td>
                    <td>@product.ProductPrice.ToString("N0") đ</td>
                    <td>@Html.DisplayFor(modelItem => product.Category.CategoryName)</td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit", new { id = product.ProductID }, new { @class = "btn btn-primary btn-sm" })
                        @Html.ActionLink("Chi tiết", "Details", new { id = product.ProductID }, new { @class = "btn btn-info btn-sm" })
                        @Html.ActionLink("Xóa", "Delete", new { id = product.ProductID }, new { @class = "btn btn-danger btn-sm" })
                    </td>
                </tr>
            }
        </tbody>
    </table>

    //Phân trang
    <p>
        Trang @Model.Products.PageNumber / @Model.Products.PageCount
        (tổng @Model.Products.TotalItemCount sản phẩm)
    </p>

    @Html.PagedListPager(Model.Products, page => Url.Action("Index", new
    {
        page,
        searchTerm = Model.SearchTerm,
        minPrice = Model.MinPrice,
        maxPrice = Model.MaxPrice,
        sortOrder = Model.SortOrder
    }))
}
else
{
    <p class="alert alert-warning">Không tìm được sản phẩm nào phù hợp.</p>
}

<p>
    @Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
</p>