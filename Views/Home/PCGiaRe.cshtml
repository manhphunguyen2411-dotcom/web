@{
    ViewBag.Title = "PC Giá Rẻ";
}

@section styles {
    <link href="~/Content/category.css" rel="stylesheet" />
}

<div class="product-grid">

    <!-- sản phẩm 1 -->
    <div class="product-card">
        <div class="product-image">
            <img src="~/Content/img/PCGR1.png" alt="PC 1">

        </div>
        <div class="product-info">
            <div class="product-price">35.250.000 đ</div>
            <div class="product-title">
                HHPC ULTRA 5 250K PLUS | 32GB DDR5 | NVIDIA RTX 3050 6G
            </div>
        </div>
        <div class="ps-foot">
            <span class="ps-stock">Sẵn hàng</span>
            <form action="/Home/ThemVaoGio" method="post">
                <input type="hidden" name="ten" value="Intel Core i5-14400F (Up to 4.7GHz, 10 nhân 16 luồng)" />
                <input type="hidden" name="gia" value="3990000" />
                <input type="hidden" name="hinh" value="/Content/img/CPU1.PNG" />
                <button type="submit" class="ps-add">+</button>
            </form>
        </div>
    </div>

