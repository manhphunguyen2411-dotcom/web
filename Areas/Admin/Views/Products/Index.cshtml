@model HoangHaPCVN.Models.ViewModel.ProductSearchVM

@{
    ViewBag.Title = "Sản phẩm";
}

<h2 class="bg-success text-white p-2">DANH SÁCH SẢN PHẨM</h2>

@* Form tìm kiếm *@
@using (Html.BeginForm("Index", "Products", FormMethod.Get))
{
    <div class="row g-2 align-items-center mb-3">
        <div class="col-md-5">
            @Html.TextBoxFor(m => m.SearchTerm, new
            {
                @class = "form-control",
                placeholder = "Nhập tên, mô tả hoặc loại sản phẩm",
                maxLength = 100, //Limit ký tự Input (chả quan trọng ở Admin)
                min = 0 //Chặn số âm
            })
        </div>

        @* Trường tìm kiếm theo khoảng giá *@
        <div class="col-md-2">
            @Html.TextBoxFor(m => m.MinPrice, new
       {
           @class = "form-control",
           placeholder = "Giá tối thiểu",
           type = "number",
           maxLength = 100, //Limit ký tự Input (chả quan trọng ở Admin)
           min = 0 //Chặn số âm
       })
        </div>
        <div class="col-md-2">
            @Html.TextBoxFor(m => m.MaxPrice, new
            {
                @class = "form-control",
                placeholder = "Giá tối đa",
                type = "number"
            })
        </div>

        @* Giữ lại cách sắp xếp đang chọn khi bấm Tìm kiếm *@
        @Html.HiddenFor(m => m.SortOrder)

        <div class="col-md-3">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            @Html.ActionLink("Xóa lọc", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>
}

@* Tùy chọn sắp xếp *@
<div class="mb-3">
    Sắp xếp theo:
    @Html.ActionLink("Tên tăng dần", "Index",
        new { sortOrder = "name_asc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice })
    |
    @Html.ActionLink("Tên giảm dần", "Index",
        new { sortOrder = "name_desc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice })
    |
    @Html.ActionLink("Giá tăng dần", "Index",
        new { sortOrder = "price_asc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice })
    |
    @Html.ActionLink("Giá giảm dần", "Index",
        new { sortOrder = "price_desc", searchTerm = Model.SearchTerm, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice })
</div>

@* Form kết quả tìm kiếm *@
@Html.Partial("PVListProduct", Model)